{
  "info": {
    "_postman_id": "b3f4a9d4-collection",
    "name": "Order Execution Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Basic requests for the Order Execution Engine API"
  },
  "item": [
    {
      "name": "Create Order - valid",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"tokenIn\": \"SOL\", \"tokenOut\": \"USDC\", \"amount\": 10 }"
        },
        "url": { "raw": "http://localhost:3000/api/orders/execute", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","orders","execute"] }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('body has orderId', () => pm.expect(body).to.have.property('orderId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order - invalid",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"tokenIn\": \"SOL\" }" },
        "url": { "raw": "http://localhost:3000/api/orders/execute", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","orders","execute"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('status is 400', function () { pm.response.to.have.status(400); });"] } }
      ]
    },
    {
      "name": "List Orders",
      "request": { "method": "GET", "url": { "raw": "http://localhost:3000/api/orders", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","orders"] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));","const b = pm.response.json();","pm.test('has orders and count', ()=>{ pm.expect(b).to.have.property('orders'); pm.expect(b).to.have.property('count'); });"] } } ]
    },
    {
      "name": "Get Order - not found",
      "request": { "method": "GET", "url": { "raw": "http://localhost:3000/api/orders/non-existent", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","orders","non-existent"] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('status is 404', () => pm.response.to.have.status(404));"] } } ]
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": { "raw": "http://localhost:3000/health", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["health"] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));","const b = pm.response.json();","pm.test('has services', ()=>{ pm.expect(b).to.have.property('services'); pm.expect(b.services).to.have.property('database'); pm.expect(b.services).to.have.property('redis'); });"] } } ]
    },
    {
      "name": "Get Queue Stats",
      "request": { "method": "GET", "url": { "raw": "http://localhost:3000/api/orders/queue/stats", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","orders","queue","stats"] } },
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('status 200', ()=> pm.response.to.have.status(200));"] } } ]
    }
  ]
}
